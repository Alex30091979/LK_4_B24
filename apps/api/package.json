{
  "name": "@lk/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:migrate:pg": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:migrate:pg:dev": "prisma migrate dev --name init --schema prisma/schema.postgres.prisma",
    "db:studio:pg": "prisma studio --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@lk/shared": "0.0.1",
    "@prisma/client": "^6.0.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "google-auth-library": "^9.15.0",
    "lru-cache": "^11.0.2",
    "nanoid": "^5.0.8",
    "otplib": "^12.0.1",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "prisma": "^6.0.1"
  }
}


