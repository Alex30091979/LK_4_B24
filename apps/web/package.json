{
  "name": "@lk/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx tsc -p tsconfig.json --noEmit && npx vite build",
    "build:standalone": "npx tsc -p tsconfig.json --noEmit && npx vite build --base=./ --mode standalone",
    "preview": "npx vite preview",
    "preview:standalone": "npx vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint not configured\""
  },
  "dependencies": {
    "@lk/shared": "0.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}


