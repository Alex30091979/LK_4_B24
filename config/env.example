# ===== API =====
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# DB
DATABASE_URL=file:../../data/dev.sqlite

# Bitrix24 integration
# BITRIX_MODE=real | mock
BITRIX_MODE=mock
BITRIX_BASE_URL=https://your-domain.bitrix24.ru
BITRIX_WEBHOOK_PATH=/rest/1/your-webhook-token/
BITRIX_REFERRER_FIELD=UF_CRM_REFERRER_ID
BITRIX_DEAL_REWARD_FIELD=UF_CRM_REWARD_AMOUNT
BITRIX_DEAL_DATE_FIELD=CLOSEDATE

# SMS provider (demo: stub)
SMS_PROVIDER=stub


